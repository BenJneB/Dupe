    {
      "name": "series",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"series\" (\"id\" TEXT NOT NULL, \"user_id\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"sync_pending\" INTEGER NOT NULL DEFAULT 1 CHECK (\"sync_pending\" IN (0, 1)), \"type\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"original_title\" TEXT NULL, \"authors\" TEXT NOT NULL DEFAULT '[]', \"publisher\" TEXT NULL, \"collection\" TEXT NULL, \"status_publication\" TEXT NOT NULL DEFAULT 'inconnue', \"total_volumes\" INTEGER NULL, \"cover_url\" TEXT NULL, \"description\" TEXT NULL, \"external_ids\" TEXT NOT NULL DEFAULT '{}', \"followed\" INTEGER NOT NULL DEFAULT 1 CHECK (\"followed\" IN (0, 1)), \"notes\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"items\" (\"id\" TEXT NOT NULL, \"user_id\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"sync_pending\" INTEGER NOT NULL DEFAULT 1 CHECK (\"sync_pending\" IN (0, 1)), \"series_id\" TEXT NULL REFERENCES series (id), \"type\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"volume_number\" TEXT NULL, \"isbn13\" TEXT NULL, \"upc\" TEXT NULL, \"authors\" TEXT NOT NULL DEFAULT '[]', \"publisher\" TEXT NULL, \"edition\" TEXT NULL, \"format\" TEXT NULL, \"publish_date\" TEXT NULL, \"page_count\" INTEGER NULL, \"language\" TEXT NULL, \"cover_url\" TEXT NULL, \"description\" TEXT NULL, \"ownership\" TEXT NOT NULL DEFAULT 'possede', \"reading_status\" TEXT NOT NULL DEFAULT 'non_lu', \"read_date\" TEXT NULL, \"rating\" INTEGER NULL, \"is_first_edition\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_first_edition\" IN (0, 1)), \"is_variant\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_variant\" IN (0, 1)), \"condition\" TEXT NULL, \"purchase_price\" REAL NULL, \"purchase_date\" TEXT NULL, \"cover_price\" REAL NULL, \"estimated_value\" REAL NULL, \"currency\" TEXT NOT NULL DEFAULT 'EUR', \"wishlist_priority\" INTEGER NULL, \"wishlist_max_price\" REAL NULL, \"location\" TEXT NULL, \"notes\" TEXT NULL, \"source\" TEXT NULL, \"source_id\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
