          "sql": "CREATE TABLE IF NOT EXISTS \"loans\" (\"id\" TEXT NOT NULL, \"user_id\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"sync_pending\" INTEGER NOT NULL DEFAULT 1 CHECK (\"sync_pending\" IN (0, 1)), \"item_id\" TEXT NOT NULL REFERENCES items (id), \"borrower_name\" TEXT NOT NULL, \"loaned_at\" TEXT NOT NULL, \"due_at\" TEXT NULL, \"returned_at\" TEXT NULL, \"notes\" TEXT NULL, PRIMARY KEY (\"id\"));"
